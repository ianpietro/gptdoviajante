{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/inspiracoes", "destination": "/api/inspiracoes" },
    { "source": "/inspiracoes/(.*)", "destination": "/api/inspiracoes?slug=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/v/(.*)", "destination": "/app.html?shared=$1" }
  ]
}
